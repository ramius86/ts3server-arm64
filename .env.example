# TeamSpeak 3 Server ARM64 — Environment Configuration Template
# Copy this file to .env and adjust as necessary.

# Image tag to use (default: latest, can be set to specific TS3 version like 3.13.8)
TS3_IMAGE=ghcr.io/ramius86/ts3server-arm64:latest

# Timezone database name for the container
TIME_ZONE=Europe/Rome

# User ID and Group ID to run the ts3server process under (prevents permission conflicts)
PUID=1000
PGID=1000

# Enable (1) or disable (0) creation and usage of a custom ts3server.ini file
INIFILE=1

# Hold the container in shell sleep mode for debugging purposes (0 = run server, 1 = debug mode)
DEBUG=0

# Accept the TeamSpeak 3 Server license (mandatory, must be "accept")
TS3SERVER_LICENSE=accept

# Number of days to keep server logs. Set to 0 to disable automated log cleanup.
LOG_CLEANUP_DAYS=7
